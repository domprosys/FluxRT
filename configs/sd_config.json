{
    "backend": "sd",
    "python": "../StreamDiffusion-daydream/.venv/bin/python",
    "worker_cwd": "../StreamDiffusion-daydream",
    "resolution": {
        "width": 512,
        "height": 512
    },
    "default_prompt": "anime style illustration, vibrant colors",
    "prompt_cycle": [
        "anime style illustration, vibrant colors",
        "oil painting, thick impasto brush strokes",
        "cyberpunk style, neon lights, glowing magenta and cyan",
        "pencil sketch, graphite drawing",
        "watercolor painting, soft washes",
        "pixel art, 16-bit retro game style",
        "claymation, plasticine clay figure",
        "white marble statue, carved stone"
    ],
    "prompt_cycle_interval_s": 20,
    "input_smoothing_alpha": 1.0,
    "worker_env": {
        "TOKENIZERS_PARALLELISM": "false"
    },
    "worker": {
        "model_id": "stabilityai/sd-turbo",
        "t_index_list": [
            18,
            35
        ],
        "num_inference_steps": 50,
        "acceleration": "none",
        "use_tiny_vae": true,
        "cfg_type": "none",
        "guidance_scale": 1.0,
        "delta": 1.0,
        "seed": 2,
        "use_denoising_batch": true,
        "negative_prompt": "",
        "engine_dir": "engines"
    },
    "_alt_worker_dreamshaper8": {
        "_note": "stronger stylisation on faces; swap into 'worker' to use (needs peft, LCM LoRA auto-added)",
        "model_id": "Lykon/dreamshaper-8",
        "use_lcm_lora": true,
        "t_index_list": [
            22,
            38
        ],
        "num_inference_steps": 50,
        "acceleration": "none",
        "use_tiny_vae": true,
        "cfg_type": "self",
        "guidance_scale": 1.2,
        "delta": 0.8,
        "seed": 2,
        "use_denoising_batch": true,
        "negative_prompt": ""
    }
}